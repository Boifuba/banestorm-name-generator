<form class="flexcol name-generator-wrapper">
  <!-- Mode Toggle Buttons -->
  <div class="form-group name-generator-section">
    <div class="name-generator-group">
      <label class="form-label">
        <i class="fas fa-toggle-on"></i>
        Generation Type:
      </label>
      <div class="form-fields flexrow">
        <button type="button" class="btn {{#if (eq currentMode 'people')}}btn-primary{{else}}btn-secondary{{/if}}" 
                data-mode="people">
          <i class="fas fa-user"></i>
          People Names
        </button>
        <button type="button" class="btn {{#if (eq currentMode 'places')}}btn-primary{{else}}btn-secondary{{/if}}" 
                data-mode="places">
          <i class="fas fa-city"></i>
          Place Names
        </button>
        <button type="button" class="btn {{#if (eq currentMode 'races')}}btn-primary{{else}}btn-secondary{{/if}}" 
                data-mode="races">
          <i class="fas fa-dragon"></i>
          Race Names
        </button>
      </div>
    </div>
  </div>

  {{#if (eq currentMode 'people')}}
  <!-- People Names Section -->
  <div class="form-group name-generator-section">
    <div class="name-generator-group">
      <label for="nation-select" class="form-label">
        <i class="fas fa-flag"></i>
        Select Nation:
      </label>
      <div class="form-controls">
        <select id="nation-select" class="form-control name-generator-select">
          {{#each nations}}
          <option value="{{value}}" {{#if (eq ../selectedNation value)}}selected{{/if}}>
            {{label}}
          </option>
          {{/each}}
        </select>
      </div>
    </div>

    <div class="name-generator-group">
      <label class="form-label">
        <i class="fas fa-venus-mars"></i>
        Select Gender:
      </label>
      <div class="form-fields flexrow">
        {{#each genders}}
        <button type="button" class="btn {{#if (eq ../selectedGender value)}}btn-primary{{else}}btn-secondary{{/if}}" 
                data-gender="{{value}}">
          <i class="{{icon}}"></i>
          {{label}}
        </button>
        {{/each}}
      </div>
    </div>

    <div class="name-generator-group">
      <label class="form-label">
        <i class="fas fa-text-width"></i>
        Name Type:
      </label>
      <div class="form-fields flexrow">
        {{#each nameTypes}}
        <button type="button" class="btn {{#if (eq ../selectedNameType value)}}btn-primary{{else}}btn-secondary{{/if}}" 
                data-name-type="{{value}}">
          <i class="{{icon}}"></i>
          {{label}}
        </button>
        {{/each}}
      </div>
    </div>

    <div class="name-generator-group">
      <button type="button" id="generate-btn" class="btn btn-primary generate-button">
        <i class="fas fa-dice"></i>
        Generate Names
      </button>
    </div>
  </div>

  <div class="form-group name-generator-section">
    <fieldset class="name-generator-list">
      <legend class="form-label">
        <i class="fas fa-list"></i>
        Generated Names
      </legend>
      <div class="results-container">
        {{#if generatedNames}}
          {{#each generatedNames}}
          <button type="button" class="btn name-item" data-name="{{name}}">
            <i class="{{icon}}"></i>
            <span class="name-text">{{name}}</span>
          </button>
          {{/each}}
        {{else}}
          <div class="notification info">
            <i class="fas fa-info-circle"></i>
            Click "Generate Names" to create a list of names
          </div>
        {{/if}}
      </div>
    </fieldset>
  </div>
  {{/if}}

  {{#if (eq currentMode 'races')}}
  <!-- Race Names Section -->
  <div class="form-group name-generator-section">
    <div class="name-generator-group">
      <label for="race-select" class="form-label">
        <i class="fas fa-dragon"></i>
        Select Race:
      </label>
      <div class="form-controls">
        <select id="race-select" class="form-control name-generator-select">
          {{#each races}}
          <option value="{{value}}" {{#if (eq ../selectedRace value)}}selected{{/if}}>
            {{label}}
          </option>
          {{/each}}
        </select>
      </div>
    </div>

    <div class="name-generator-group">
      <label class="form-label">
        <i class="fas fa-venus-mars"></i>
        Select Gender:
      </label>
      <div class="form-fields flexrow">
        {{#each genders}}
        <button type="button" class="btn {{#if (eq ../selectedGender value)}}btn-primary{{else}}btn-secondary{{/if}}" 
                data-gender="{{value}}">
          <i class="{{icon}}"></i>
          {{label}}
        </button>
        {{/each}}
      </div>
    </div>

    <div class="name-generator-group">
      <button type="button" id="generate-races-btn" class="btn btn-primary generate-button">
        <i class="fas fa-dice"></i>
        Generate Names
      </button>
    </div>
  </div>

  <div class="form-group name-generator-section">
    <fieldset class="name-generator-list">
      <legend class="form-label">
        <i class="fas fa-list"></i>
        Generated Names
      </legend>
      <div class="results-container">
        {{#if generatedRaces}}
          {{#each generatedRaces}}
          <button type="button" class="btn race-item" data-name="{{name}}">
            <i class="{{icon}}"></i>
            <span class="name-text">{{name}}</span>
          </button>
          {{/each}}
        {{else}}
          <div class="notification info">
            <i class="fas fa-info-circle"></i>
            Click "Generate Names" to create a list of names
          </div>
        {{/if}}
      </div>
    </fieldset>
  </div>
  {{/if}}

  {{#if (eq currentMode 'places')}}
  <!-- Places Names Section -->
  <div class="form-group name-generator-section">
    <div class="name-generator-group">
      <label for="place-nation-select" class="form-label">
        <i class="fas fa-map"></i>
        Select Nation:
      </label>
      <div class="form-controls">
        <select id="place-nation-select" class="form-control name-generator-select">
          {{#each placeNations}}
          <option value="{{value}}" {{#if (eq ../selectedPlaceNation value)}}selected{{/if}}>
            {{label}}
          </option>
          {{/each}}
        </select>
      </div>
    </div>

    <div class="name-generator-group">
      <button type="button" id="generate-places-btn" class="btn btn-primary generate-button">
        <i class="fas fa-dice"></i>
        Generate Place Names
      </button>
    </div>
  </div>

  <div class="form-group name-generator-section">
    <fieldset class="name-generator-places-list">
      <legend class="form-label">
        <i class="fas fa-map"></i>
        Generated Places
      </legend>
      <div class="results-container">
        {{#if generatedPlaces}}
          {{#each generatedPlaces}}
          <button type="button" class="btn place-item" data-name="{{name}}" data-type="{{type}}">
            <i class="{{icon}}"></i>
            <span class="name-text">{{name}}</span>
          </button>
          {{/each}}
        {{else}}
          <div class="notification info">
            <i class="fas fa-info-circle"></i>
            Click "Generate Place Names" to create a list of places
          </div>
        {{/if}}
      </div>
    </fieldset>
  </div>
  {{/if}}
</form>